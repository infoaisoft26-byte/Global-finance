rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    match /brochures/global-finance-brochure.pdf {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 67108864
        && request.resource.contentType == 'application/pdf';
      allow delete: if false;
    }

    // Poster uploads are stored in the uploader's own folder. The API still
    // enforces Neon admin role before a poster can be published to members.
    match /offer-posters/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 10485760
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}

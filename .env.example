# Client-side Firebase config remains in src/firebase-config.json.
# The server verifies Firebase ID tokens with Firebase Admin credentials below.

APP_URL="https://globalfinance1.online"
DATABASE_URL="postgresql://user:password@YOUR-NEON-POOLER.neon.tech/globalfinance?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Firebase Admin credentials (server-only; never prefix these with VITE_)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional: the Firebase account with this email is promoted to the Neon admin role on secure sync.
ADMIN_EMAIL="admin@example.com"

# Real-money execution is disabled by default. Enable only after validating the provider/RPC and operations process.
PAYMENTS_ENABLED="false"
PAYOUTS_ENABLED="false"
USDT_RECHARGE_ENABLED="false"

# BNB Smart Chain mainnet RPC and the verified USDT BEP20 token contract.
BSC_RPC_URL=""
USDT_BEP20_CONTRACT_ADDRESS=""

# Optional guarded auto-credit. It only works when all recharge settings above are enabled,
# the on-chain transfer is verified with >=12 confirmations, and this flag is true.
PAYMENT_AUTO_CREDIT_ENABLED="false"
# Fixed accounting conversion used for automatic Fund Wallet credit, e.g. 1 USDT = 83.50 INR.
# Leave blank to keep requests pending for admin review instead of guessing a conversion rate.
USDT_TO_INR_RATE=""

# Gemini AI Studio runtime secret, only if Gemini functionality is actually used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

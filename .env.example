# Client-side Firebase config remains in src/firebase-config.json.
# The server verifies Firebase ID tokens with Firebase Admin credentials below.

APP_URL="https://YOUR-VERCEL-PROJECT.vercel.app"
DATABASE_URL="postgresql://user:password@YOUR-NEON-POOLER.neon.tech/globalfinance?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Firebase Admin credentials (server-only; never prefix these with VITE_)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Optional: the Firebase account with this email is promoted to the Neon admin role on secure sync.
ADMIN_EMAIL="admin@example.com"

# Real-money execution remains disabled until an authorized provider/compliance setup is complete.
PAYMENTS_ENABLED="false"
PAYOUTS_ENABLED="false"

# TRON Shasta testnet deposit integration. TEST TOKENS ONLY.
# Keep production payments/payouts disabled while this is enabled.
TRON_TESTNET_ENABLED="false"
TRON_TESTNET_DEPOSIT_ADDRESS="YOUR_SHASTA_TRON_ADDRESS"
# Official TRON docs use this Shasta USDT example contract.
TRON_TESTNET_TRC20_CONTRACT="TG3XXyExBkPp9nzdajDZsozEu4BkaSJozs"
TRON_TESTNET_TOKEN_DECIMALS="6"
# Test-only accounting rate used to credit the existing INR fund wallet.
TRON_TESTNET_INR_PER_USDT="100"
# Optional on Shasta; useful if you configure a TronGrid key.
TRONGRID_API_KEY=""

# Gemini AI Studio runtime secret, only if Gemini functionality is actually used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /system_settings/global_finance_system_settings {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'admin@gf.app';
      allow delete: if false;
    }

    // Transaction history is append-only from the application/server side.
    // Members may read only their own ledger entries.
    // Admin may read the full ledger for Transaction Adjudication Control.
    match /transactions/{transactionId} {
      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || (
            request.auth.token.email != null
            && request.auth.token.email.lower() == 'admin@gf.app'
          )
        );
      allow create, update, delete: if false;
    }

    // Wallets are server-controlled. Clients must not mutate balances directly.
    match /wallets/{userId} {
      allow read: if request.auth != null
        && (
          userId == request.auth.uid
          || (
            request.auth.token.email != null
            && request.auth.token.email.lower() == 'admin@gf.app'
          )
        );
      allow create, update, delete: if false;
    }

    // Support tickets: members can create and read only their own tickets.
    // Admins can read/update all tickets. AI acknowledgement is an owner-only append.
    match /tickets/{ticketId} {
      function isAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.userEmail is string
        && request.resource.data.subject is string
        && request.resource.data.message is string;

      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if request.auth != null && (
        isAdmin()
        ||
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.subject == resource.data.subject
          && request.resource.data.category == resource.data.category
          && request.resource.data.priority == resource.data.priority
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('adminReply', null) == resource.data.get('adminReply', null)
          && request.resource.data.get('subject', '') == resource.data.get('subject', '')
          && request.resource.data.messages.size() == resource.data.messages.size() + 1
          && request.resource.data.messages[request.resource.data.messages.size() - 1].senderRole == 'ai'
          && request.resource.data.messages[request.resource.data.messages.size() - 1].senderId == 'SYSTEM_AI'
          && request.resource.data.get('aiReply', '') == request.resource.data.messages[request.resource.data.messages.size() - 1].message
        )
      );

      allow delete: if false;
    }

    // All other documents remain server-controlled.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
